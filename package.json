{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:native": "node scripts/build-native.mjs",
    "desktop:setup": "npm install --no-save electron electron-builder",
    "desktop:exe": "npm run build:native && npx electron-builder --config electron-builder.yml --win nsis portable --publish never",
    "mobile:setup": "npm install --no-save @capacitor/core @capacitor/cli @capacitor/android && npx cap add android",
    "mobile:apk": "npm run build:native && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:cpanel": "vite build && npx esbuild server.ts --bundle --platform=node --target=node18 --format=esm --outfile=app.js --external:pg --external:dotenv --external:express --external:@neondatabase/serverless --external:vite --external:nodemailer",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "postinstall": "node patch-vite.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
